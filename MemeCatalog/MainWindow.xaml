<Window x:Class="MemeCatalog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MemeCatalog"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Button Content="Browse" HorizontalAlignment="Center" Margin="0,329,0,85" 
        Click="Browse_Click" Height="20" Width="124"/>
        <Button Content="Save" HorizontalAlignment="Center" Margin="0,366,0,48" 
        Click="Save_Click" Height="20" Width="123"/>
        <MediaElement Name="mediaElement" HorizontalAlignment="Left" Height="275" Margin="192,26,0,0" VerticalAlignment="Top" Width="482"/>
        <TextBox Name="TextBoxPath" HorizontalAlignment="Left" Margin="168,329,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="TextBoxName" HorizontalAlignment="Left" Margin="168,372,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Button Content="Dodaj Tag" HorizontalAlignment="Left" Margin="541,320,0,0" VerticalAlignment="Top" Height="38" Width="131" Click="Tag_Click"/>
        <ListView Name="ListView" Margin="0,0,642,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="BrowseMemes" HorizontalAlignment="Left" Margin="659,26,0,0" VerticalAlignment="Top" Height="38" Width="131" Click="BrowseMemes_Click"/>
        <Button Content="Dodaj Tag" HorizontalAlignment="Left" Margin="541,261,0,0" VerticalAlignment="Top" Height="38" Width="131" Click="Tag_Click"/>
    </Grid>
</Window>
